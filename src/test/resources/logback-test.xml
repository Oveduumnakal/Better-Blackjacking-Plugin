<?xml version="1.0" encoding="UTF-8"?>
<!--
Test logging: keeps unit-test output quiet by logging only warnings and errors to the
console. The plugin's own debug lines stay off unless a test turns them on.
-->
<configuration>
	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
		</encoder>
	</appender>

	<root level="WARN">
		<appender-ref ref="STDOUT"/>
	</root>
</configuration>
